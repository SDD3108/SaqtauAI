{
  "expo": {
    "name": "Saqtau AI",
    "slug": "Saqtau AI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SaqtauAI Logo.png",
    "scheme": "saqtauapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundler": "metro",
      "icon": "./assets/images/SaqtauAI Logo.png",
      "bundleIdentifier": "com.sd3108.Saqtau-AI"
    },
    "android": {
      "bundler": "metro",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SaqtauAI Logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/SaqtauAI Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/SaqtauAI Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/SaqtauAI Logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
