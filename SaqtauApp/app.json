{
  "expo": {
    "name": "Saqtau AI",
    "slug": "SaqtauAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SaqtauAI Logo.png",
    "scheme": "saqtau",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundler": "metro",
      "appleTeamId": "5QZMMBZ7R7",
      "icon": "./assets/images/SaqtauAI Logo.png",
      "bundleIdentifier": "com.sd3108.Saqtau-AI",
      "associatedDomains": [
        "applinks:links.saqtau.ai",
        "applinks:links.saqtau.ai"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "bundler": "metro",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SaqtauAI Logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/SaqtauAI Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.sd3108.SaqtauAI"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/SaqtauAI Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/SaqtauAI Logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SaqtauAI to use your camera for 60-second wellness check-ins.",
          "microphonePermission": "Allow SaqtauAI to use your microphone for voice features.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow SaqtauAI to use motion data to help keep your check-in stable."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Saqtau AI to record voice messages for transcription."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ru",
              "kk"
            ],
            "android": [
              "en",
              "ru",
              "kk"
            ]
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-build-properties",
      "@react-native-community/datetimepicker",
      "./plugins/with-saqtau-screen-time",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82ebc2ab-fc5a-4575-a6f6-5063ffa8cc33",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SaqtauScreenTimeMonitor",
                  "bundleIdentifier": "com.sd3108.Saqtau-AI.ScreenTimeMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.sd3108.Saqtau-AI.screentime"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "sd3108"
  }
}
