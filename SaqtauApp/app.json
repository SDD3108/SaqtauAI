{
  "expo": {
    "name": "Saqtau AI",
    "slug": "Saqtau AI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SaqtauAI Logo.png",
    "scheme": "saqtauapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundler": "metro",
      "icon": "./assets/images/SaqtauAI Logo.png",
      "bundleIdentifier": "com.sd3108.Saqtau-AI"
    },
    "android": {
      "bundler": "metro",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SaqtauAI Logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/SaqtauAI Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/SaqtauAI Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/SaqtauAI Logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SaqtauAI to use your camera for 60-second wellness check-ins.",
          "microphonePermission": "Allow SaqtauAI to use your microphone for voice features.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow SaqtauAI to use motion data to help keep your check-in stable."
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
